# Google Cloud / Gemini AI API Key
GCP_API_KEY=your_gcp_api_key_here
GEMINI_API_KEY=your_gcp_api_key_here

# Computer Vision Quality Thresholds
LM_BLUR_THRESHOLD=40.0
LM_DEBLUR_THRESHOLD=80.0
LM_MIN_IMAGE_WIDTH=300
LM_MIN_IMAGE_HEIGHT=200
LM_MIN_BRIGHTNESS=30.0
LM_MAX_BRIGHTNESS=245.0
LM_MIN_CONTRAST=20.0
LM_MAX_NOISE_STD=35.0
LM_MAX_SKEW_ANGLE=45.0

# OCR Confidence & Retries
LM_CONFIDENCE_HIGH=0.70
LM_CONFIDENCE_MEDIUM=0.45
LM_MAX_OCR_RETRIES=5

# Compliance Scoring
LM_COMPLIANCE_THRESHOLD=80.0

# Gemini Settings
LM_GEMINI_TIMEOUT=30.0
LM_GEMINI_ENABLED=true
